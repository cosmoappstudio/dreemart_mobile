EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon_key>

# RevenueCat
EXPO_PUBLIC_REVENUECAT_IOS_KEY=<revenuecat_ios_key>
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=<revenuecat_android_key>
# Virtual currency (dashboard’da tanımlı kod, örn. CRD)
EXPO_PUBLIC_REVENUECAT_VIRTUAL_CURRENCY_CODE=CRD
# generate-dream + revenuecat-webhook Edge Functions (Supabase Secrets — mobil bundle’a koyma):
# REVENUECAT_API_SECRET=<RevenueCat → Project settings → API keys → Secret API key, v2 UYUMLU; legacy key 403 verir: https://errors.rev.cat/authorization-error
# REVENUECAT_PROJECT_ID=proj_xxxx
# REVENUECAT_VIRTUAL_CURRENCY_CODE=CRD
# revenuecat-webhook: RevenueCat Dashboard → Webhooks; Authorization: Bearer <REVENUECAT_WEBHOOK_AUTH> (function ile aynı secret)
# REVENUECAT_WEBHOOK_AUTH=<güçlü_rasgele_string>

# Amplitude Analytics (Project Settings → API Keys; tek key iOS + Android)
EXPO_PUBLIC_AMPLITUDE_API_KEY=<amplitude_key>

# Meta / Facebook SDK (react-native-fbsdk-next; native build gerekir)
# App ID: Meta > Uygulama paneli üstündeki sayı.
# İstemci jetonu: Ayarlar > Temel > "İstemci jetonu" (Client token). Bu, uygulama sırrı (App Secret) DEĞİLDİR — sırrı asla EXPO_PUBLIC_ ile koyma.
EXPO_PUBLIC_FACEBOOK_APP_ID=<facebook_app_id>
EXPO_PUBLIC_FACEBOOK_CLIENT_TOKEN=<facebook_client_token>
# Sunucu / Graph API için (mobil bundle'a girmez):
# META_APP_SECRET=<app_secret_sadece_backend>

# EAS Build (push için gerekli)
EAS_PROJECT_ID=<eas_project_id>
EAS_OWNER=<expo_username>
# Simülatör dev client: eas build --profile ios-simulator --platform ios

# Yönetici paneli push (Edge Function: admin-send-push) — değerler Supabase Secrets’ta:
# ADMIN_PANEL_USERNAME, ADMIN_PANEL_PASSWORD, ADMIN_PANEL_ORIGIN (CORS, opsiyonel)
